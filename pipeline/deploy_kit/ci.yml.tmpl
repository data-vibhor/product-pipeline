name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install dependencies
        run: |
          python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb'))['project']; print(chr(10).join(p['dependencies']+p['optional-dependencies']['dev']))" > requirements-ci.txt
          pip install -r requirements-ci.txt
      - name: Run tests
        env:
          SECRET_KEY: ci-only-secret-key-at-least-32-characters
          ENVIRONMENT: testing
        run: python -m pytest -q

  image:
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - name: Build production image
        run: docker build -f Dockerfile.prod -t app:ci .
