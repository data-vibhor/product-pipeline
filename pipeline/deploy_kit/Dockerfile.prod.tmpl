FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install only the runtime dependencies declared in pyproject.toml
COPY pyproject.toml ./
RUN python -c "import tomllib; print(chr(10).join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > requirements.txt \
    && pip install -r requirements.txt

RUN groupadd -r appuser && useradd -r -g appuser appuser

COPY app/ ./app/
{{COPY_STATIC}}COPY start.py ./
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD ["python", "start.py"]
